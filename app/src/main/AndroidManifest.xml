<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- AiGate's OFFLINE state reads whether the default network is validated (TRD §6.2). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      An OpenAI-compatible AI server on your own network (AI-05, TRD §6.2). From Android 17, an app targeting
      API 37 can't reach local-network addresses without it. Asked for only when such a server is set.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Keeps the rest timer's alert on time while the phone sleeps during a rest (TRD §6.1). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Active workout runs as a foreground service of type "health" (TRD §6.1). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!--
      Health Connect reads (TRD §6.3), one feature each, asked for only when you turn that feature on: steps;
      sleep; other apps' workouts; the InBody app's weight, body fat and BMR. Recomp writes nothing there.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" />
    <!-- The daily sync while the app is closed, where Health Connect offers it. Without it, sync runs at launch only. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" />

    <!-- The names of the apps that wrote a workout ("from Google Fit"): apps that work with Health Connect. -->
    <queries>
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
            <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
        </intent>
    </queries>

    <application
        android:name=".RecompApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="Recomp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Recomp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Health Connect shows this when you tap the app's privacy policy in its permission screen. -->
        <activity
            android:name=".healthconnect.PermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".healthconnect.ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".healthconnect.PermissionsRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- WorkManager starts on demand with Hilt's worker factory (RecompApp), not from androidx.startup. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <service
            android:name=".workout.ActiveWorkoutService"
            android:exported="false"
            android:foregroundServiceType="health" />
    </application>
</manifest>
