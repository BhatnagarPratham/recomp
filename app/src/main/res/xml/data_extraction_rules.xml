<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto Backup and device-to-device transfer (TRD §6.2, §6.5): only the database and the settings,
  listed by name. Everything not included stays on the phone, notably the encrypted Claude API key
  (datastore/secrets.preferences_pb) and the Tink keyset that wraps it (shared prefs recomp_ai_keyset.xml):
  the keyset is bound to this phone's Android Keystore, so a restored copy couldn't be decrypted anyway, and
  the key must never reach a backup. The in-app safety copy and the rest timer's state stay too. (Lint
  rejects an <exclude> outside an included path, so the key files are left out by omission, not by name.)
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="recomp.db" />
        <include domain="database" path="recomp.db-wal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="recomp.db" />
        <include domain="database" path="recomp.db-wal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
