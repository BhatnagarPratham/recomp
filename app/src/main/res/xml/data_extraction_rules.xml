<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto Backup and device-to-device transfer (TRD §6.2, §6.5): only the database and the settings,
  listed by name. Anything not included is left out, so the in-app safety copy and the rest timer's state
  stay on the phone. The encrypted Claude API key and the Tink keyset that wraps it are excluded by name as
  well: the keyset is bound to this phone's Android Keystore, so a restored copy couldn't be decrypted anyway,
  and the key must never reach a backup.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="recomp.db" />
        <include domain="database" path="recomp.db-wal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
        <exclude domain="sharedpref" path="recomp_ai_keyset.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="recomp.db" />
        <include domain="database" path="recomp.db-wal" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
        <exclude domain="sharedpref" path="recomp_ai_keyset.xml" />
    </device-transfer>
</data-extraction-rules>
